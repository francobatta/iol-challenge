# The nginx image fills in ${DNS_RESOLVER} and ${API_URL} from the environment when the
# container starts, and leaves nginx's own $variables alone. The Dockerfile sets both for
# compose; deploy/k8s/base/web.yaml sets them for Kubernetes.
server {
    listen 80;
    root /usr/share/nginx/html;

    # The API. Looked up when a request arrives rather than when nginx starts, so that
    # the console comes up without the API and finds it again after it restarts.
    location /v1/ {
        resolver ${DNS_RESOLVER} valid=10s;
        set $api ${API_URL};
        proxy_pass $api;
        # POST /v1/users/import takes a file of up to 64 MiB; the API enforces that.
        client_max_body_size 64m;
    }

    # For the probes of whatever runs the container.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Built files carry a hash of their content in their name, so they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The API's description, which the docs page draws. nginx has no type for YAML.
    location = /openapi.yaml {
        default_type application/yaml;
    }

    # Every other address is a page of the app, which the browser routes itself.
    location / {
        try_files $uri /index.html;
    }
}
