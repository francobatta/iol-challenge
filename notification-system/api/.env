# Configuration of the API server. Compose loads it as it is, and
# Kubernetes gets it as a ConfigMap:
#
#   kubectl -n notifications create configmap api-config --from-env-file=api/.env
#
# The values are for local development: the hosts are compose services and the
# credentials are placeholders. A real deployment would keep the last four in a secret
# store; they are here to keep the example simple.

# Address the API listens on.
ADDR=:8080
# Address /metrics is served on.
METRICS_ADDR=:9090
# Base URL of an OTLP/HTTP collector to export traces to. Empty exports none.
OTEL_EXPORTER_OTLP_ENDPOINT=

DATABASE_URL=postgres://audience:audience@db:5432/audience
AMQP_URL=amqp://notify:notify@rabbitmq:5672/
# Signs app tokens.
JWT_SECRET=dev-jwt-secret
# Authorizes creating apps.
ADMIN_KEY=dev-admin-key
