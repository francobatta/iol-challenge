# Configuration of the workers and the mock provider under compose, which loads this
# file as it is. Kubernetes does not read it: its configuration is in deploy/k8s.
#
# The values are for local development: the hosts are compose services and the
# credentials are placeholders. A real deployment would keep the two RabbitMQ URLs in a
# secret store; they are here to keep the example simple.
#
# PROVIDER is not here: it is what tells the four worker pools apart, so each sets its own.

# A worker runs min(CONCURRENCY, PREFETCH x apps with a backlog) sends at once. The KEDA
# targets in deploy/k8s/base/workers/pool/scaledobject.yaml assume the same two values.
CONCURRENCY=200
PREFETCH=50
# Address a worker serves /metrics, /healthz and /readyz on.
METRICS_ADDR=:9090
# Base URL of an OTLP/HTTP collector to export traces to. Empty exports none.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

AMQP_URL=amqp://notify:notify@rabbitmq:5672/
# The RabbitMQ management API. The workers list their queues through it, and KEDA reads
# queue depth and publish rate from it.
RABBITMQ_API_URL=http://notify:notify@rabbitmq:15672
# Base URL of the provider APIs. In a real deployment each worker pool would point at its
# own provider; here they all point at the mock.
PROVIDER_URL=http://mockprovider:8081

# The mock provider: the address it listens on, and the fraction of requests (0 to 1) it
# answers 500 or 429.
ADDR=:8081
ERROR_RATE=0
THROTTLE_RATE=0
